# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — it is never committed, unlike this example.

FMA_DB_HOST=localhost
FMA_DB_USER=findmyandroid
FMA_DB_PASSWORD=
FMA_DB_NAME=findmyandroid

# Generate with: php -r "echo bin2hex(random_bytes(32));"
FMA_CODE_LOOKUP_PEPPER=

# Generate with: php -r "echo base64_encode(random_bytes(32));"
FMA_TOTP_ENCRYPTION_KEY_BASE64=
